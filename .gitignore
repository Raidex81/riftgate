# Never commit real API keys
secrets.local.js

# Dependencies and build output — these get rebuilt from source, don't
# belong in version control
node_modules/
dist/

# OS/editor cruft
.DS_Store
Thumbs.db

# Local scratch/backup files created while iterating on changes — not
# meant to be tracked, just safety copies kept during editing
*.bak-*
_to_delete/
strix_runs/
